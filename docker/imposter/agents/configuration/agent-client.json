{
  "data": {
    "agent": {
      "config-profile": "ubuntu, ubuntu20, ubuntu20.04",
      "notify_time": 10,
      "time-reconnect": 60,
      "auto_restart": "yes",
      "remote_conf": "yes",
      "manager": {
        "endpoint": "wazuh.manager:1517/wazuh-manager/",
        "max_retries": 5,
        "retry_interval": 10
      },
      "batch": {
        "size": 1000,
        "interval": 10
      },
      "enrollment": {
        "enabled": "yes",
        "delay_after_enrollment": 20,
        "group": "default",
        "ssl_cipher": "HIGH:!ADH:!EXP:!MD5:!RC4:!3DES:!CAMELLIA:@STRENGTH",
        "auto_method": "no"
      }
    }
  },
  "error": 0
}
