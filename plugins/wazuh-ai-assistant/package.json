{
  "name": "wazuh-ai-assistant",
  "version": "5.0.0",
  "revision": "07",
  "description": "Wazuh AI Assistant - provider-agnostic AI chat plugin for the Wazuh dashboard (OpenSearch Dashboards)",
  "license": "GPL-2.0-only",
  "private": true,
  "pluginPlatform": {
    "version": "3.6.0"
  },
  "scripts": {
    "build": "yarn plugin-helpers build --opensearch-dashboards-version=$OPENSEARCH_DASHBOARDS_VERSION",
    "plugin-helpers": "node ../../scripts/plugin_helpers",
    "osd": "node ../../scripts/osd",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test:jest": "node scripts/jest --runInBand",
    "test:eval:build": "tsc -p tsconfig.test.json",
    "lint": "eslint \"{public,server,common}/**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "eslint \"{public,server,common}/**/*.{js,jsx,ts,tsx}\" --fix",
    "knip": "knip --files"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-filenames-simple": "^0.9.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "knip": "^5.88.1",
    "prettier": "^2.7.1",
    "typescript": "^5.5.2",
    "typescript-eslint": "^8.56.1"
  }
}
